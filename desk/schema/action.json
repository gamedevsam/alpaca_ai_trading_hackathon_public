{
  "$id": "entity/alpaca/action",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlpacaAction",
  "prefix": "AAC",
  "type": "object",
  "required": ["type", "header", "body"],
  "properties": {
    "type": { "const": "alpaca_action" },
    "header": {
      "type": "object",
      "required": ["owner_user_id", "environment", "status", "last_activity_at"],
      "properties": {
        "owner_user_id": { "type": "string" },
        "environment": { "type": "string", "enum": ["paper", "live"] },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "proposed",
            "approved",
            "rejected",
            "submitted",
            "filled",
            "failed",
            "canceled",
            "reconciled",
            "expired",
            "discarded"
          ]
        },
        "last_activity_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "required": [
        "environment",
        "status",
        "mandateId",
        "symbol",
        "side",
        "orderType",
        "qty",
        "notional",
        "limitPrice",
        "timeInForce",
        "rationale",
        "clearedLimits",
        "approval",
        "instrument",
        "clientOrderId",
        "alpacaOrderId",
        "fills",
        "events",
        "errorMessage",
        "optionOutcome"
      ],
      "properties": {
        "environment": { "type": "string", "enum": ["paper", "live"] },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "proposed",
            "approved",
            "rejected",
            "submitted",
            "filled",
            "failed",
            "canceled",
            "reconciled",
            "expired",
            "discarded"
          ]
        },
        "mandateId": { "type": ["string", "null"] },
        "symbol": { "type": "string" },
        "side": { "type": "string", "enum": ["buy", "sell"] },
        "orderType": { "type": "string", "enum": ["market", "limit"] },
        "qty": { "type": ["number", "null"] },
        "notional": { "type": ["number", "null"] },
        "limitPrice": { "type": ["number", "null"] },
        "timeInForce": { "type": "string", "enum": ["day", "gtc"] },
        "rationale": { "type": "string" },
        "signalIds": { "type": "array", "items": { "type": "string" } },
        "predictionId": { "type": ["string", "null"] },
        "clearedLimits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["limit", "passed"],
            "properties": {
              "limit": { "type": "string" },
              "passed": { "type": "boolean" },
              "detail": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "approval": {
          "anyOf": [
            { "const": null },
            {
              "type": "object",
              "required": ["decision", "decidedAt"],
              "properties": {
                "decision": { "type": "string", "enum": ["approved", "rejected"] },
                "decidedAt": { "type": "string", "format": "date-time" },
                "decidedBy": { "type": ["string", "null"] },
                "tokenId": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          ]
        },
        "instrument": {
          "anyOf": [
            { "const": null },
            {
              "type": "object",
              "required": [
                "assetClass",
                "underlying",
                "occSymbol",
                "expiration",
                "strike",
                "right",
                "multiplier",
                "positionIntent"
              ],
              "properties": {
                "assetClass": { "const": "option" },
                "underlying": { "type": "string" },
                "occSymbol": { "type": "string" },
                "expiration": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "strike": { "type": "number" },
                "right": { "type": "string", "enum": ["call", "put"] },
                "multiplier": { "type": "number" },
                "positionIntent": {
                  "type": "string",
                  "enum": ["buy_to_open", "sell_to_open", "buy_to_close", "sell_to_close"]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "clientOrderId": { "type": "string" },
        "alpacaOrderId": { "type": ["string", "null"] },
        "fills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["qty", "price", "filledAt"],
            "properties": {
              "qty": { "type": "number" },
              "price": { "type": "number" },
              "filledAt": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "status", "message"],
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "status": { "type": "string" },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "expiresAt": { "anyOf": [{ "type": "string", "format": "date-time" }, { "const": null }] },
        "execution": {
          "anyOf": [
            { "const": null },
            {
              "type": "object",
              "required": ["via"],
              "properties": {
                "via": { "type": "string", "enum": ["http", "cli"] },
                "cliVersion": { "type": ["string", "null"] },
                "dryRun": {
                  "anyOf": [
                    { "const": null },
                    {
                      "type": "object",
                      "required": ["at", "command", "requestBody"],
                      "properties": {
                        "at": { "type": "string", "format": "date-time" },
                        "command": { "type": "string" },
                        "requestBody": { "type": "object", "additionalProperties": true }
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                "submit": {
                  "anyOf": [
                    { "const": null },
                    {
                      "type": "object",
                      "required": ["at", "command", "response"],
                      "properties": {
                        "at": { "type": "string", "format": "date-time" },
                        "command": { "type": "string" },
                        "response": { "type": "object", "additionalProperties": true }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "errorMessage": { "type": ["string", "null"] },
        "optionOutcome": {
          "anyOf": [
            { "const": null },
            {
              "type": "object",
              "required": ["kind", "occurredAt", "detail"],
              "properties": {
                "kind": { "type": "string", "enum": ["assigned", "expired_worthless"] },
                "occurredAt": { "type": "string", "format": "date-time" },
                "detail": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "id": { "$ref": "~/entity.json#/properties/id" },
    "owner_id": { "$ref": "~/entity.json#/properties/owner_id" },
    "external_id": { "$ref": "~/entity.json#/properties/external_id" },
    "status": { "$ref": "~/entity.json#/properties/status" },
    "schema_version": { "$ref": "~/entity.json#/properties/schema_version" },
    "created_at": { "$ref": "~/entity.json#/properties/created_at" },
    "updated_at": { "$ref": "~/entity.json#/properties/updated_at" }
  },
  "additionalProperties": false
}
