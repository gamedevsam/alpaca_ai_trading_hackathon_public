{
  "$id": "entity/alpaca/signal",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlpacaSignal",
  "prefix": "ASG",
  "type": "object",
  "required": ["type", "header", "body"],
  "properties": {
    "type": { "const": "alpaca_signal" },
