      "properties": {
        "owner_user_id": { "type": "string" },
        "environment": { "type": "string", "enum": ["paper", "live"] },
        "channel_id": { "type": "string" },
        "video_id": { "type": "string" },
        "ticker": { "type": "string" },
        "signal_status": { "type": "string", "enum": ["open", "acted", "resolved"] }
      },
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "required": [
        "environment",
        "channelEntityId",
        "channelId",
        "channelTitle",
        "videoId",
        "videoTitle",
        "publishedAt",
        "ticker",
        "direction",
        "thesis",
        "horizonDays",
        "confidence",
        "quote",
        "timestampSec",
        "sourceRef",
        "referencePrice",
        "falsifiableCondition",
        "resolveBy",
        "predictionId",
        "status",
        "actedActionId",
        "extractedAt",
        "provider",
        "model"
      ],
      "properties": {
        "environment": { "type": "string", "enum": ["paper", "live"] },
        "channelEntityId": { "type": "string" },
        "channelId": { "type": "string" },
        "channelTitle": { "type": "string" },
        "videoId": { "type": "string" },
        "videoTitle": { "type": "string" },
        "publishedAt": { "type": ["string", "null"] },
        "ticker": { "type": "string" },
        "direction": { "type": "string", "enum": ["bullish", "bearish", "neutral"] },
        "thesis": { "type": "string" },
        "horizonDays": { "type": "number" },
        "confidence": { "type": "number" },
        "quote": { "type": "string" },
        "timestampSec": { "type": ["number", "null"] },
        "sourceRef": { "type": "string" },
        "referencePrice": { "type": ["number", "null"] },
        "falsifiableCondition": { "type": "string" },
        "resolveBy": { "type": "string" },
        "predictionId": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["open", "acted", "resolved"] },
        "actedActionId": { "type": ["string", "null"] },
        "lastDeclinedAt": { "type": ["string", "null"] },
        "lastDeclineReason": { "type": ["string", "null"] },
        "extractedAt": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "id": { "$ref": "~/entity.json#/properties/id" },
    "owner_id": { "$ref": "~/entity.json#/properties/owner_id" },
    "external_id": { "$ref": "~/entity.json#/properties/external_id" },
    "status": { "$ref": "~/entity.json#/properties/status" },
    "schema_version": { "$ref": "~/entity.json#/properties/schema_version" },
    "created_at": { "$ref": "~/entity.json#/properties/created_at" },
    "updated_at": { "$ref": "~/entity.json#/properties/updated_at" }
  },
  "additionalProperties": false
}
